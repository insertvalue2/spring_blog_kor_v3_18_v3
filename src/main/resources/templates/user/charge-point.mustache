{{> layout/header}}

<div class="container p-5">
    <div class="card">
        <div class="card-header">
            <h4 class="mb-0"><b>포인트 충전</b></h4>
        </div>
        <div class="card-body">
            <div>
                <label class="form-label fw-bold">현재 보유 포인트</label>
                <div class="mb-4">
                    <span class="badge bg-primary fs-5">{{user.point}} P</span>
                </div>
            </div>
            <hr/>
            <div class="mb-4">
                <label class="form-label fw-bold mb-3">충전할 포인트 선택</label>
                <div class="row g-3">
                    <div class="col-md-4"><button type="button" class="btn btn-outline-primary w-100 point-btn" data-amount="1000">1,000 P</button></div>
                    <div class="col-md-4"><button type="button" class="btn btn-outline-primary w-100 point-btn" data-amount="5000">5,000 P</button></div>
                    <div class="col-md-4"><button type="button" class="btn btn-outline-primary w-100 point-btn" data-amount="10000">10,000 P</button></div>
                    <div class="col-md-4"><button type="button" class="btn btn-outline-primary w-100 point-btn" data-amount="20000">20,000 P</button></div>
                    <div class="col-md-4"><button type="button" class="btn btn-outline-primary w-100 point-btn" data-amount="50000">50,000 P</button></div>
                    <div class="col-md-4"><button type="button" class="btn btn-outline-primary w-100 point-btn" data-amount="100000">100,000 P</button></div>
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label fw-bold">충전 예정 금액</label>
                <p class="form-control-plaintext">
                    <span class="badge bg-success fs-5" id="selectedAmount">0</span> P
                </p>
            </div>

            <div class="d-grid gap-2">
                <button type="button" class="btn btn-primary" id="chargeBtn" disabled>충전하기</button>
                <a href="/user/detail" class="btn btn-secondary">취소</a>
            </div>
        </div>
    </div>
</div>

<!-- 포트원 V2 브라우저 문서에서 확인 가능 SDK -->
<script src="https://cdn.portone.io/v2/browser-sdk.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        let selectedAmount = 0;
        // $btn 이 변수는 DOM 엘리먼트(또는 NodeList)를 담고 있다
        const $btnList = document.querySelectorAll('.point-btn');
        const $displayAmount = document.getElementById('selectedAmount');
        const $chargeBtn = document.getElementById('chargeBtn');

        // 선택 금액 갱신
        function updateAmount(amount) {
            selectedAmount = amount;
            $displayAmount.textContent = amount.toLocaleString();
            $chargeBtn.disabled = (amount <= 0);
        }

        // 금액 버튼 클릭
        $btnList.forEach(btn => {
            btn.addEventListener('click', function () {
                $btnList.forEach(b => b.classList.remove('active'));
                this.classList.add('active');
                updateAmount(parseInt(this.getAttribute('data-amount')));
            });
        });

        // 충전하기 = [Step1] prepare → [Step2] 포트원 V2 결제창 → [Step3] complete(검증)
        $chargeBtn.addEventListener('click', async function () {
            if (selectedAmount <= 0) return;
            $chargeBtn.disabled = true;

            try {
                // [Step 1] 서버에서 결제 건(paymentId) 발급 + storeId/channelKey 수신
                const prepareRes = await fetch('/api/payment/prepare', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({amount: selectedAmount})
                });
                if (!prepareRes.ok) {
                    alert("결제 요청 실패");
                    //const e = await prepareRes.json().catch(() => ({}));
                    //throw new Error(e.message || '결제 준비에 실패했습니다.');
                }
                const prepare = await prepareRes.json();

                // [Step 2] 포트원 V2 결제창 호출 (카카오페이 = 간편결제)
                const payment = await PortOne.requestPayment({
                    storeId: prepare.storeId,
                    channelKey: prepare.channelKey,
                    paymentId: prepare.paymentId,
                    orderName: '포인트 충전',
                    totalAmount: prepare.amount,
                    currency: 'CURRENCY_KRW',
                    payMethod: 'EASY_PAY'
                });

                // 결제 실패/취소 시 응답에 code 가 존재
                if (payment.code !== undefined && payment.code !== null) {
                    alert('결제에 실패하였습니다.\n' + payment.message);
                    return;
                }

                // [Step 3] 서버 검증 (최종 승인 + 포인트 지급)
                const completeRes = await fetch('/api/payment/complete', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({paymentId: payment.paymentId})
                });
                if (!completeRes.ok) {
                    alert("결제 검증에 실패했습니다. 관리자에게 문의 xxx");
                    // const e = await completeRes.json().catch(() => ({}));
                    // throw new Error(e.message || '결제 검증에 실패했습니다.');
                }
                const result = await completeRes.json();

                alert(`충전이 완료되었습니다!\n충전된 금액: ${result.amount.toLocaleString()}P\n현재 잔액: ${result.currentPoint.toLocaleString()}P`);
                location.href = '/user/detail';

            } catch (err) {
                alert(err.message);
            } finally {
                $chargeBtn.disabled = false;
            }
        });
    });
</script>
{{> layout/footer}}
